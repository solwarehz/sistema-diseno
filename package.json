{
  "name": "sistema-diseno-ae",
  "version": "1.50.0",
  "description": "Sistema de diseño web del Colegio Albert Einstein — implementación ejecutable de MMI-DS",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solwarehz/sistema-diseno.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "files": [
    "sistema/tokens",
    "sistema/candado",
    "sistema/iconos",
    "sistema/componentes",
    "componentes/src",
    "manual",
    "CLAUDE.md"
  ],
  "exports": {
    ".": "./sistema/tokens/fuente.mjs",
    "./iconos": "./sistema/iconos/iconos.mjs",
    "./tokens.css": "./sistema/tokens/tokens.css",
    "./preset": "./sistema/tokens/tailwind-preset.ts",
    "./fuente": "./sistema/tokens/fuente.mjs",
    "./lock": "./sistema/tokens/paleta.lock.json",
    "./eslint": "./sistema/candado/candado.eslint.config.mjs",
    "./package.json": "./package.json",
    "./componentes.css": "./sistema/componentes/componentes.css",
    "./comportamiento.md": "./sistema/componentes/comportamiento.md",
    "./componentes": "./componentes/src/index.ts",
    "./componentes/*": "./componentes/src/*.tsx",
    "./verificar-color": "./sistema/candado/verificar-color.mjs",
    "./politica": "./sistema/componentes/POLITICA-DE-CREACION.md"
  },
  "scripts": {
    "generar": "node sistema/tokens/generar.mjs",
    "verificar": "node sistema/candado/verificar-contraste.mjs",
    "catalogo": "node sistema/cascaron/generar-cascaron.mjs",
    "auditar": "node sistema/candado/auditar-cascaron.mjs",
    "servir": "node sistema/cascaron/servir.mjs",
    "probar-candado": "node sistema/candado/probar-candado.mjs",
    "componentes": "node sistema/componentes/extraer.mjs",
    "lint": "eslint .",
    "lint-real": "sh sistema/candado/probar-con-eslint.sh",
    "componentes-probar": "cd componentes && vitest run",
    "verificar-color": "node sistema/candado/verificar-color.mjs"
  },
  "devDependencies": {
    "eslint": "^9.14.0",
    "typescript-eslint": "^8.13.0",
    "typescript": "^5.6.3"
  }
}
